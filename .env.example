# Overview page of your Microsoft Foundry project.
FOUNDRY_PROJECT_ENDPOINT=https://your-project.services.ai.azure.com
# Deployment name from "Models + endpoints" in your Foundry project.
FOUNDRY_MODEL_NAME=gpt-4o
FOUNDRY_AGENT_NAME=BasicAgent

# Optional: overrides the default system instructions.
# AGENT_INSTRUCTIONS=You are a helpful, concise assistant.

# --- Optional MCP server ---
# Set to true to attach an MCP server as a tool the agent can call.
MCP_ENABLED=false
MCP_NAME=Microsoft Learn MCP
MCP_URL=https://learn.microsoft.com/api/mcp
