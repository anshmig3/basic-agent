FOUNDRY_PROJECT_ENDPOINT="https://your-project.services.ai.azure.com"
AZURE_AI_MODEL_DEPLOYMENT_NAME="gpt-4o"
AGENT_NAME="BasicAgent"
# AGENT_INSTRUCTIONS="You are a helpful, concise assistant."

# --- Optional MCP servers (hosted / remote MCP tools) ---
# JSON array of {name, url, approval_mode, headers} objects, one per MCP
# server to attach. approval_mode is "never_require" or "always_require"
# (defaults to never_require if omitted); headers is optional, e.g. for an
# Authorization bearer token. Leave empty/unset to run with no MCP tools.
MCP_SERVERS='[{"name":"Microsoft Learn MCP","url":"https://learn.microsoft.com/api/mcp"}]'
